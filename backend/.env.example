# ── Seguridad ─────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura-de-64-chars

# ── Base de datos ─────────────────────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite:///./restaurante.db
# Producción (PostgreSQL en Render):
# DATABASE_URL=postgresql://user:password@host/dbname

# ── CORS ──────────────────────────────────────────────────────────────────
# Local:
FRONTEND_ORIGIN=http://localhost:5173
# Producción (separar con coma si hay varios):
# FRONTEND_ORIGIN=https://app.zyquid.com

# ── Entorno ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Producción:
# ENVIRONMENT=production

# ── Token de acceso ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
